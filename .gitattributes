# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Source code and config files: enforce LF line endings across all platforms
*.py text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.env* text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows-specific scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - prevent Git from modifying them
*.docx binary
*.xlsx binary
*.pdf binary
*.pptx binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
