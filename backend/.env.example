# Copy to .env and adjust: cp .env.example .env
# Every value has a default in app/config/settings.py; set only what you need to change.

# --- Application ---
APP_NAME=SafeSpend API
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# --- Database (async SQLAlchemy URL, asyncpg driver) ---
# Docker Compose database (make db), exposed on host port 5433:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/safespend
# Local Homebrew PostgreSQL started with database/start.sh (connects as your OS user):
# DATABASE_URL=postgresql+asyncpg://localhost:5432/safespend
DATABASE_ECHO=false

# --- Authentication (JWT) ---
# Required outside development. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-jwt-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
